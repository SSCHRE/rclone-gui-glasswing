{
  "name": "rclone-glasswing-gui",
  "version": "1.3.0",
  "description": "Glasswing — an electron based Rclone GUI with a live job dashboard and modern UI.",
  "main": "electron/main.js",
  "scripts": {
    "icons": "node scripts/generate-icons.js",
    "prebuild": "npm run icons",
    "start": "electron .",
    "build": "electron-builder --win portable nsis --publish never",
    "build:portable": "electron-builder --win portable --publish never",
    "build:setup": "electron-builder --win nsis --publish never",
    "build:dir": "electron-builder --win dir --publish never",
    "build:linux": "node scripts/build-linux.js AppImage deb",
    "build:linux:appimage": "node scripts/build-linux.js AppImage",
    "build:linux:deb": "node scripts/build-linux.js deb",
    "build:linux:dir": "node scripts/build-linux.js dir",
    "build:linux:wsl": "node scripts/build-linux-wsl.js AppImage deb",
    "build:linux:native": "electron-builder --linux AppImage deb --publish never"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8"
  },
  "build": {
    "appId": "com.rclone.gui.glasswing",
    "productName": "Glasswing Rclone",
    "icon": "build/icon.ico",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Glasswing Rclone",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "runAfterFinish": false
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "synopsis": "Rclone GUI with live job dashboard",
      "description": "Glasswing — an electron based Rclone GUI with a live job dashboard and modern UI.",
      "maintainer": "Glasswing",
      "target": [
        "AppImage",
        "deb"
      ],
      "desktop": {
        "entry": {
          "Name": "Glasswing Rclone",
          "Comment": "Rclone GUI with live job dashboard",
          "Categories": "Utility;"
        }
      }
    },
    "deb": {
      "packageCategory": "utils",
      "recommends": [
        "rclone"
      ]
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "build/icon.png",
      "build/icon.ico"
    ]
  },
  "allowScripts": {
    "electron@35.7.5": true
  }
}
